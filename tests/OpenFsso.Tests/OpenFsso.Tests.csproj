<Project Sdk="MSTest.Sdk/4.4.1">
  <!-- Windows-targeted assemblies load on the Linux build host; tests avoid Windows APIs. -->
  <!-- Tests are not trimmed, but share the application's reflection-free JSON setting. -->
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><EnableTrimAnalyzer>false</EnableTrimAnalyzer></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OpenFsso.Core/OpenFsso.Core.csproj" />
    <ProjectReference Include="../../src/OpenFsso.Configuration/OpenFsso.Configuration.csproj" />
    <ProjectReference Include="../../src/OpenFsso.Client/OpenFsso.Client.csproj" />
    <ProjectReference Include="../../src/OpenFsso.Receiver/OpenFsso.Receiver.csproj" />
    <ProjectReference Include="../../src/OpenFsso.Logging/OpenFsso.Logging.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <None Include="../../config/*.example.yaml" Link="config/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
