{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openfsso:client",
  "title": "OpenFSSO client configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["Receivers", "StateDirectory", "LogDirectory"],
  "properties": {
    "Receivers": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["Name", "Host", "Address", "Port"],
        "properties": {
          "Name": { "type": "string", "pattern": "\\S", "maxLength": 64 },
          "Host": { "type": "string", "format": "hostname" },
          "Address": {
            "type": "string",
            "anyOf": [{ "format": "ipv4" }, { "format": "ipv6" }]
          },
          "Port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "CheckRevocation": { "type": "boolean" }
        }
      }
    },
    "StateDirectory": { "type": "string", "minLength": 1 },
    "LogDirectory": { "type": "string", "minLength": 1 },
    "AllowRdp": { "type": "boolean" },
    "onFabric": { "$ref": "#/$defs/rule" }
  },
  "$defs": {
    "rule": {
      "oneOf": [
        { "$ref": "#/$defs/allGroup" },
        { "$ref": "#/$defs/anyGroup" },
        { "$ref": "#/$defs/notGroup" },
        { "$ref": "#/$defs/condition" }
      ]
    },
    "notGroup": {
      "type": "object", "additionalProperties": false, "required": ["not"],
      "properties": { "not": { "$ref": "#/$defs/rule" } }
    },
    "allGroup": {
      "type": "object", "additionalProperties": false, "required": ["all"],
      "properties": {
        "all": {
          "type": "array", "minItems": 2, "maxItems": 32,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "anyGroup": {
      "type": "object", "additionalProperties": false, "required": ["any"],
      "properties": {
        "any": {
          "type": "array", "minItems": 2, "maxItems": 32,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "minProperties": 1, "maxProperties": 1,
      "properties": {
        "clientIp": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": { "type": "string", "format": "cidr" }
        },
        "dhcpServer": {
          "type": "object", "additionalProperties": false, "required": ["ip"],
          "properties": {
            "ip": { "type": "string", "format": "ipv4" },
            "mac": {
              "type": "string",
              "pattern": "^(?:[0-9A-Fa-f]{12}|(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}|(?:[0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2})$"
            }
          }
        }
      }
    }
  }
}
